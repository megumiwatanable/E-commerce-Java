# ============================================================
# E-Commerce Order Management System — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# Database Configuration
MYSQL_HOST=workspace-mysql-1
MYSQL_USERNAME=root
MYSQL_PASSWORD=changeme

# JWT Configuration
# Generate a secure random string (min 32 chars) for production
# Example: openssl rand -base64 64
JWT_SECRET=change-this-to-a-secure-random-string
ADMIN_JWT_SECRET=use-a-different-base64-secret-at-least-32-bytes
GATEWAY_INTERNAL_SECRET=use-a-random-internal-service-secret

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# Service URLs (for local development, outside Docker)
PRODUCT_SERVICE_URL=http://localhost:18082
INVENTORY_SERVICE_URL=http://localhost:18083
ORDER_SERVICE_URL=http://localhost:18084
PAYMENT_SERVICE_URL=http://localhost:18085
NOTIFICATION_SERVICE_URL=http://localhost:18086

# Service Ports (for local development)
FRONTEND_HOST_PORT=14200
ZOOKEEPER_HOST_PORT=12181
KAFKA_HOST_PORT=19092
API_GATEWAY_HOST_PORT=18090
USER_SERVICE_HOST_PORT=18081
ADMIN_SERVICE_HOST_PORT=18087
PRODUCT_SERVICE_HOST_PORT=18082
INVENTORY_SERVICE_HOST_PORT=18083
ORDER_SERVICE_HOST_PORT=18084
PAYMENT_SERVICE_HOST_PORT=18085
NOTIFICATION_SERVICE_HOST_PORT=18086
