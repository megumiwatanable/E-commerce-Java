# ============================================================
# E-Commerce Order Management System — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# Database Configuration
MYSQL_HOST=workspace-mysql-1
MYSQL_USERNAME=root
MYSQL_PASSWORD=changeme

# JWT Configuration
# Generate a secure random string (min 32 chars) for production
# Example: openssl rand -base64 64
JWT_SECRET=change-this-to-a-secure-random-string

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Service URLs (for local development, outside Docker)
PRODUCT_SERVICE_URL=http://localhost:8082
INVENTORY_SERVICE_URL=http://localhost:8083
ORDER_SERVICE_URL=http://localhost:8084
PAYMENT_SERVICE_URL=http://localhost:8085
NOTIFICATION_SERVICE_URL=http://localhost:8086

# Service Ports (for local development)
API_GATEWAY_PORT=8080
USER_SERVICE_PORT=8081
PRODUCT_SERVICE_PORT=8082
INVENTORY_SERVICE_PORT=8083
ORDER_SERVICE_PORT=8084
PAYMENT_SERVICE_PORT=8085
NOTIFICATION_SERVICE_PORT=8086
